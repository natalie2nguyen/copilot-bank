{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "type": "node",
            "request": "launch",
            "name": "Launch Program",
            "skipFiles": [
                "<node_internals>/**"
            ],
            "program": "${file}",
            "outFiles": [
                "${workspaceFolder}/**/*.js"
            ]
        },
        {
            "type": "node",
            "request": "launch",
            "name": "Debug borrow-funds tests",
            "program": "${workspaceFolder}/bank-api/node_modules/vitest/vitest.mjs",
            "args": [
                "run",
                "tests/borrow-funds.test.ts"
            ],
            "cwd": "${workspaceFolder}/bank-api",
            "autoAttachChildProcesses": true,
            "console": "integratedTerminal"
        }
    ]
}